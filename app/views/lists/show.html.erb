
<div class="list-show">

  <div class="list-hero">
    <div class="list-hero__overlay"></div>

    <div class="list-hero__content">
      <h1><%= @list.name %></h1>
    </div>

    <div class="list-hero__count">
      <%= pluralize(@list.bookmarks.count, "movie") %>
    </div>

  </div>

  <div class="list-content">

    <div class="list-content__actions">
      <%= link_to new_list_bookmark_path(@list), class: "add-movie-btn" do %>
        <i class="fa-solid fa-plus"></i>
        Add a movie
      <% end %>

        <%= link_to "Back to lists",
          lists_path,
          class: "btn btn-outline-success" %>
    </div>

    <div class="movies-grid">

      <% @list.bookmarks.includes(:movie).each do |bookmark| %>

        <div class="movie-card">

          <div class="movie-card__poster">
            <% if bookmark.movie.poster_url.present? %>
              <%= image_tag bookmark.movie.poster_url,
                  alt: bookmark.movie.title %>
            <% else %>
              <div class="movie-card__placeholder">
                <i class="fa-solid fa-film"></i>
              </div>
            <% end %>
          </div>

          <div class="movie-card__body">

            <div class="movie-card__header">
              <h3><%= bookmark.movie.title %></h3>

              <div class="movie-rating">
                <%= bookmark.movie.rating %>
                <i class="fa-solid fa-star"></i>
              </div>
            </div>

            <p class="movie-card__overview">
              <%= truncate(bookmark.movie.overview, length: 180) %>
            </p>

            <!-- COMMENT -->
            <div class="movie-card__footer">

              <div class="movie-comment">
                <i class="fa-solid fa-quote-left"></i>
                <span><%= bookmark.comment %></span>
              </div>

              <%= button_to "Remove",
                  list_bookmark_path(@list, bookmark),
                  method: :delete,
                  form: { data: { turbo_confirm: "Are you sure?" } },
                  class: "btn btn-danger" %>

            </div>

          </div>
        </div>

      <% end %>

    </div>

    <% if @list.bookmarks.empty? %>
      <div class="empty-list">
        <i class="fa-solid fa-film"></i>
        <h3>No movies yet</h3>
        <p>Start building your collection by adding your first movie.</p>
      </div>
    <% end %>

  </div>
</div>
