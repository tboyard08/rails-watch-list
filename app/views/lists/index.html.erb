
<div class="lists-page">

  <!-- HEADER BANNER -->
  <section class="lists-banner">
    <div class="lists-banner__overlay"></div>

    <div class="lists-banner__content">
      <h1>Discover Your Movie Lists</h1>
    </div>

    <div class="lists-banner__decoration">
      <i class="fa-solid fa-film"></i>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <div class="lists-container">

    <div class="lists-header">
      <div>
        <h2>My Lists</h2>
      </div>

      <%= link_to new_list_path, class: "create-list-btn" do %>
        <i class="fa-solid fa-plus"></i>
        Create a movie list
      <% end %>
    </div>

    <!-- LISTS GRID -->
    <% if @lists.any? %>

      <div class="lists-grid">

        <% @lists.each do |list| %>

          <%= link_to list_path(list), class: "list-card-link" do %>

            <div class="list-card">

              <div class="list-card__cover">
                <div class="list-card__cover-overlay"></div>

                <div class="list-card__icon">
                  <i class="fa-solid fa-clapperboard"></i>
                </div>

                <span class="list-card__count">
                  <%= pluralize(list.bookmarks.count, "movie") %>
                </span>
              </div>

              <div class="list-card__body">
                <h3><%= list.name %></h3>

                <div class="list-card__footer">
                  <span>View List</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </div>
              </div>

            </div>

          <% end %>

        <% end %>

      </div>

    <% else %>

      <div class="lists-empty">
        <i class="fa-solid fa-film"></i>
        <h3>No movie lists yet</h3>
        <p>Create your first list and start organizing your favorite movies.</p>

        <%= link_to "Create my first list",
            new_list_path,
            class: "create-list-btn" %>
      </div>

    <% end %>

  </div>
</div>
